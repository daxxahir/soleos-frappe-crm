# /etc/systemd/system/asterisk.service - reconstructed from audited unit
[Unit]
Description=Asterisk PBX
After=network.target

[Service]
Type=forking
User=asterisk
Group=asterisk
WorkingDirectory=/var/lib/asterisk
ExecStart=/usr/sbin/asterisk -g -U asterisk -G asterisk
ExecReload=/usr/sbin/asterisk -rx 'core reload'
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
