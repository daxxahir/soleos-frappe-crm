# Project & Compose stack selection
COMPOSE_PROJECT_NAME=soleos
COMPOSE_FILE=compose.yaml:overrides/compose.mariadb.yaml:overrides/compose.redis.yaml:overrides/compose.noproxy.yaml:overrides/compose.migrator.yaml:overrides/compose.backup-cron.yaml

# Custom Soleos image built from docker/Containerfile
CUSTOM_IMAGE=soleos-frappe
CUSTOM_TAG=v16
FRAPPE_PATH=https://github.com/frappe/frappe
FRAPPE_BRANCH=v16.52.0
ERPNEXT_VERSION=v16.52.0
PULL_POLICY=never
RESTART_POLICY=unless-stopped

# Database & Redis (used by overrides/compose.mariadb.yaml & compose.redis.yaml)
DB_PASSWORD=change-this-strong-db-password
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Site routing
# For local/IP/ngrok single-site use, set DEFAULT_SITE & FRAPPE_SITE_NAME_HEADER to your site name (e.g. soleos.localhost).
# For production domain(s) with Traefik HTTPS, set FRAPPE_SITE_NAME_HEADER=$$host and match site folder name to your domain.
DEFAULT_SITE=soleos.localhost
FRAPPE_SITE_NAME_HEADER=soleos.localhost

# Ports
HTTP_PUBLISH_PORT=8080
HTTPS_PUBLISH_PORT=443
NGINX_LISTEN_PORT=8080

# Gunicorn tuning (typical workers = 2 * cores + 1)
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Auto-migrate on container start & scheduled backups (every 6 hours)
MIGRATE_SITES=true
BACKUP_CRONSTRING=@every 6h

# Production HTTPS with Traefik (replace compose.noproxy.yaml with compose.https.yaml in COMPOSE_FILE)
# LETSENCRYPT_EMAIL=admin@soleosenergy.com
# SITES_RULE=Host(`crm.soleosenergy.com`)
# TRUST_UPSTREAM_FORWARDED_PROTO=on
